# Export these variables in your shell or configure them in your hosting dashboard.
# This file is a template; the app does not automatically load .env files.
SECRET_KEY=replace-with-a-random-64-character-secret
# Local development: leave KHARCHA_ENV unset. Production HTTPS only:
# KHARCHA_ENV=production
# DATABASE_PATH=/data/kharcha.sqlite
# Optional; no key is required for the local keyword parser:
# GEMINI_API_KEY=your-server-side-key
# GEMINI_MODEL=gemini-2.5-flash-lite
